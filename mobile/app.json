{
  "expo": {
    "name": "Nest",
    "slug": "turtle-mobile",
    "scheme": "turtle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.nicolasarnedo.turtle",
      "appleTeamId": "DTT44L2ZZH"
    },
    "plugins": [
      "expo-asset",
      "./plugins/withWdkAddons",
      [
        "@qvac/sdk/expo-plugin",
        {
          "installMissingPrebuilds": true
        }
      ],
      "expo-app-intents",
      [
        "expo-audio",
        {
          "microphonePermission": "Nest turns what you say into text on this iPhone."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nest reads a receipt you choose, on this phone.",
          "cameraPermission": "Nest reads a receipt you photograph, on this phone."
        }
      ]
    ],
    "experiments": {
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    }
  }
}
