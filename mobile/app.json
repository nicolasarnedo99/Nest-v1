{
  "expo": {
    "name": "Turtle",
    "slug": "turtle-mobile",
    "scheme": "turtle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.nicolasarnedo.turtle",
      "appleTeamId": "DTT44L2ZZH"
    },
    "plugins": [
      "expo-asset",
      "./plugins/withWdkAddons",
      [
        "@qvac/sdk/expo-plugin",
        {
          "installMissingPrebuilds": true
        }
      ],
      "expo-app-intents"
    ],
    "experiments": {
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    }
  }
}
