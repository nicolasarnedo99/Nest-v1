# Created for you by `npm run setup:keys`. Testnet only.
TURTLE_RPC=https://ethereum-sepolia-rpc.publicnode.com
TURTLE_AGENT_SEED="twelve word seed phrase of the agent's WDK wallet"
TURTLE_RELAYER_KEY=0x...
# Fine-tuned adapter. Remove the line to run the base model.
TURTLE_LORA=classifier/adapters/run3/selected.gguf
# Optional: which deployment to use (default contracts/deployments/sepolia.json)
# TURTLE_DEPLOYMENT=contracts/deployments/local.json
# Optional: listen on the Tailscale address so the iPhone Shortcut can reach intake
# TURTLE_HOST=100.x.y.z
