{
  "name": "turtle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "compile:contracts": "npm --prefix contracts run compile",
    "setup:keys": "tsx scripts/setup-keys.ts",
    "deploy": "tsx scripts/deploy.ts",
    "chain": "npm --prefix contracts run node"
  },
  "dependencies": {
    "@qvac/sdk": "0.23.0",
    "@tetherto/wdk-protocol-bridge-usdt0-evm": "^1.0.0-beta.12",
    "@tetherto/wdk-wallet-evm": "^1.0.0-beta.26",
    "better-sqlite3": "13.0.3",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "axios": "1.20.0",
    "ws@^8.0.0": "8.21.3"
  }
}
